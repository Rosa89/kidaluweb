{# src/templates/app.html.jinja #}
{% extends "base.html.jinja" %}
{% import "icons.html.jinja" as ico %}
{# Nazwa aplikacji zostaje w <h1>; tytuł i opis celują w to, co rodzice wpisują w wyszukiwarkę. #}
{% block title %}{{ app.seo_title }}{% endblock %}
{% block description %}{{ app.description }}{% endblock %}
{% block content %}
{% set art = {
  'czytanie': {'house':[900,770],  'owl':[900,939]},
  'literki':  {'house':[900,1066], 'owl':[1024,1036]}
}[page_key] %}
{# sizes z reguł .ph-house{height:clamp(110px,14vw,190px)} i .ph-owl{height:clamp(100px,12.4vw,168px)}:
   szerokość to wysokość razy proporcje grafiki. #}
{% macro band_sizes(dims, min_h, vw_h, max_h) -%}
{%- set ratio = dims[0] / dims[1] -%}
(max-width: {{ (min_h * 100 / vw_h)|round(0, 'ceil')|int }}px) {{ (min_h * ratio)|round(0, 'ceil')|int }}px, (max-width: {{ (max_h * 100 / vw_h)|round(0, 'floor')|int }}px) {{ (vw_h * ratio)|round(1) }}vw, {{ (max_h * ratio)|round(0, 'ceil')|int }}px
{%- endmacro %}
<article class="page">

  <header class="band band--head">
    <div class="wrap band-head">
      <p class="band-art" aria-hidden="true">
        <img class="ph-house" src="{{ asset('img/house-' ~ page_key ~ '.webp') }}" alt=""
             srcset="{{ srcset('img/house-' ~ page_key ~ '.webp', art.house[0]) }}"
             sizes="{{ band_sizes(art.house, 110, 14, 190) }}"
             width="{{ art.house[0] }}" height="{{ art.house[1] }}">
        <img class="ph-owl" src="{{ asset('img/owl-' ~ page_key ~ '.webp') }}" alt=""
             srcset="{{ srcset('img/owl-' ~ page_key ~ '.webp', art.owl[0]) }}"
             sizes="{{ band_sizes(art.owl, 100, 12.4, 168) }}"
             width="{{ art.owl[0] }}" height="{{ art.owl[1] }}">
      </p>
      <div class="band-copy">
        <h1>{{ app.name }}</h1>
        <p class="lead">{{ app.lead }}</p>
        <ul class="facts">
          {% for f in app.facts %}
          <li>{{ f }}</li>
          {% endfor %}
        </ul>
        <p class="actions">
          <a class="play" href="{{ play_url }}">{{ c.app_page.play }}</a>
          {% if app_store_url %}
          <a class="play" href="{{ app_store_url }}">{{ c.app_page.app_store }}</a>
          {% endif %}
          {% if docs_url %}
          <a class="ghost" href="{{ docs_url }}">{{ c.app_page.docs_link }}</a>
          {% endif %}
        </p>
      </div>
    </div>
  </header>

  <section class="wrap section">
    <h2>{{ c.app_page.features_heading }}</h2>
    <ul class="cards">
      {% for f in app.features %}
      <li class="card card--{{ page_key }}">
        <span class="card-ico">{{ ico.icon(f.icon) }}</span>
        <h3>{{ f.title }}</h3>
        <p>{{ f.body }}</p>
      </li>
      {% endfor %}
    </ul>
  </section>

  <section class="wrap section split">
    <div>
      <h2>{{ c.app_page.who_heading }}</h2>
      <ul class="ticks">
        {% for w in app.who %}
        <li><span class="tick tick--{{ page_key }}">{{ ico.icon(w.icon) }}</span>{{ w.text }}</li>
        {% endfor %}
      </ul>
    </div>
    <div>
      <h2>{{ c.app_page.privacy_heading }}</h2>
      <ul class="ticks">
        {% for p in app.privacy %}
        <li><span class="tick tick--shield">{{ ico.icon('shield') }}</span>{{ p }}</li>
        {% endfor %}
      </ul>
      <p class="fine">{{ c.app_page.compliance }}</p>
      {% if docs_url %}
      <p><a class="ghost" href="{{ docs_url }}">{{ app.docs_label }}</a></p>
      {% endif %}
    </div>
  </section>

</article>
{% endblock %}
