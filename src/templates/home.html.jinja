{% extends "base.html.jinja" %}
{% import "icons.html.jinja" as ico %}
{% block body_class %} class="home"{% endblock %}
{# Tło sceny siedzi w CSS, więc przeglądarka odkrywa je dopiero po sparsowaniu
   arkusza — a to największy obrazek strony. Ekran w pionie dostaje wycinek
   (reguła przy .stage w site.css). Warunek media musi być identyczny z tamtym,
   inaczej przeglądarka pobierze oba pliki. #}
{% block head_extra %}
<link rel="preload" as="image" href="{{ asset('img/scene-forest-portrait.webp') }}" media="(max-aspect-ratio: 2/3)" fetchpriority="high">
<link rel="preload" as="image" href="{{ asset('img/scene-forest.webp') }}" media="not all and (max-aspect-ratio: 2/3)" fetchpriority="high">
{% endblock %}
{% block content %}
{# Wymiary grafik trzymamy przy szablonie, żeby każdy <img> miał jawne width/height
   i nie przesuwał układu w trakcie ładowania. #}
{% set art = {
  'czytanie': {'icon':'book',   'house':[900,770],  'owl':[900,939]},
  'literki':  {'icon':'pencil', 'house':[900,1066], 'owl':[1024,1036]}
} %}
{# sizes dla grafik na kafelkach, policzone z reguł .tile-art w site.css.
   Telefon: pole ma 5,25u wysokości przy u ≤ 15px, domek zajmuje 76%, sowa 88%.
   Scena: pole ma 13u, gdzie u = 1,1% szerokości kadru; domek 100%, sowa 88%.
   Kadr ma szerokość max(100vw, 1672/941 · 100vh), stąd osobny wariant w vh
   dla okien węższych niż proporcje grafiki tła. #}
{% macro tile_sizes(dims, phone_share, stage_share) -%}
{%- set ratio = dims[0] / dims[1] -%}
{%- set phone = (78.75 * phone_share * ratio)|round(0, 'ceil')|int -%}
{%- set stage = 14.3 * stage_share * ratio -%}
(max-width: 900px) {{ phone }}px, (max-aspect-ratio: 6/5) {{ phone }}px, (max-aspect-ratio: 1672/941) {{ (stage * 1672 / 941)|round(1) }}vh, {{ stage|round(1) }}vw
{%- endmacro %}
<div class="scene">
  <div class="stage" aria-hidden="true"></div>
  <div class="flutter" aria-hidden="true">
    {# Największy motyl ma 2,4u szerokości — te same zasady co przy kafelkach. #}
    {% for n in range(1, 4) %}
    <img class="deco-butterfly deco-butterfly--{{ n }}" src="{{ asset('img/butterfly.webp') }}" srcset="{{ srcset('img/butterfly.webp', 260) }}" sizes="(max-width: 900px) 36px, (max-aspect-ratio: 6/5) 36px, (max-aspect-ratio: 1672/941) 4.7vh, 2.7vw" alt="" width="260" height="200" loading="lazy">
    {% endfor %}
  </div>
  <div class="scene-signs" aria-hidden="true">
    <span class="hangsign hangsign--l"><img src="{{ asset('img/sign-hang.webp') }}" alt="" width="600" height="341" loading="lazy"><span>{{ c.home.sign_left }}</span></span>
    <span class="hangsign hangsign--r"><img src="{{ asset('img/sign-hang.webp') }}" alt="" width="600" height="341" loading="lazy"><span>{{ c.home.sign_right }}</span></span>
  </div>

  <div class="hero">
    <h1>{{ c.home.headline }}</h1>
    <p class="hero-sub">{{ c.home.intro }}</p>
    <ul class="badges">
      {% for b in c.home.badges %}
      <li><span class="badge-ico badge-ico--{{ loop.index }}">{{ ico.icon(['book','leaf','star'][loop.index0]) }}</span>{{ b }}</li>
      {% endfor %}
    </ul>
  </div>

  <div class="frame">
  <h2 class="skip-only" id="aplikacje">{{ c.home.apps_heading }}</h2>
  <ul class="grove">
    {% for t in c.home.tiles %}
    {% set a = art[t.key] %}
    <li class="grove-slot">
      <{% if t.url %}a href="{{ url(t.url) }}"{% else %}div{% endif %} class="tile tile--{{ t.key }}{% if not t.url %} tile--soon{% endif %}">
        <span class="tile-art">
          <img class="tile-house" src="{{ asset('img/house-' ~ t.key ~ '.webp') }}" srcset="{{ srcset('img/house-' ~ t.key ~ '.webp', a.house[0]) }}" sizes="{{ tile_sizes(a.house, 0.76, 1) }}" alt="" width="{{ a.house[0] }}" height="{{ a.house[1] }}" {% if loop.index > 3 %}loading="lazy"{% endif %}>
          <img class="tile-owl" src="{{ asset('img/owl-' ~ t.key ~ '.webp') }}" srcset="{{ srcset('img/owl-' ~ t.key ~ '.webp', a.owl[0]) }}" sizes="{{ tile_sizes(a.owl, 0.88, 0.88) }}" alt="" width="{{ a.owl[0] }}" height="{{ a.owl[1] }}" {% if loop.index > 3 %}loading="lazy"{% endif %}>
        </span>
        <span class="tile-board">
          <span class="tile-ico">{{ ico.icon(a.icon) }}</span>
          <span class="tile-copy">
            <span class="tile-name">{{ t.sign }}</span>
            <span class="tile-tag">{{ t.tagline }}</span>
          </span>
          {# Deska trzyma zapas szerokości na plakietkę „wkrótce” — patrz .tile-soon. #}
          <span class="tile-go">{{ ico.icon('arrow') }}</span>
        </span>
      </{% if t.url %}a{% else %}div{% endif %}>
    </li>
    {% endfor %}
  </ul>
  </div>

  <p class="motto">{{ c.home.motto }}<span class="motto-heart">{{ ico.icon('heart') }}</span></p>
</div>
{% endblock %}
